---
permalink: /css/design.css
eleventyExcludeFromCollections: true
---
/* GENERATED from the dashboard (Design > Colour palette and Typography). Do not edit by hand.
   Loaded after stylesheet.css. With the default settings every value here equals the students'
   own value, so the site looks exactly as they designed it until someone changes a setting.
   Optional colours left blank in the dashboard are not written at all, so the students' design
   keeps its original behaviour for them. */
{{ fontface.css | safe }}

:root {
{%- for name, value in colours %}
{%- if value %}
    --{{ name }}: {{ value | safe }};
{%- endif %}
{%- endfor %}
    --font-heading: {{ fontface.headingStack | safe }};
    --font-body: {{ fontface.bodyStack | safe }};
}
