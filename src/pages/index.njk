---
layout: layouts/base.njk
title: Home
permalink: /
---
{%- set f = frontpage %}
        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

          LOOPING ANIMATION
          Desktop and mobile versions in one <picture>: each visitor downloads only the one that fits
          their screen, straight away (it's the first thing on the page). A tiny still of the first
          frame shows while it loads. The stills are in images/stills/, named after the SVG they
          belong to, so a newly uploaded animation simply has none until they're made.

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->
{%- set dSvg = f.heroDesktop | siteImg %}
{%- set mSvg = (f.heroMobile or f.heroDesktop) | siteImg %}
{%- set dStill = dSvg | animStill %}
{%- set mStill = mSvg | animStill %}

        {#- On phones the animation and the dates banner share the first screen under the header
            (css/additions.css: .home-first-screen); on larger screens this wrapper does nothing. #}
        <div class="home-first-screen">
        <section class="logo-animation{% if dStill %} has-still{% endif %}"
            {%- if dStill %} style="--still: url('{{ dStill.small | url }}');{% if mStill %} --still-m: url('{{ mStill.small | url }}');{% endif %}"{% endif %}>
            <picture>
                <source media="(max-width: 676px)" srcset="{{ mSvg | url }}?v={{ mSvg | fileHash }}">
                <img src="{{ dSvg | url }}?v={{ dSvg | fileHash }}" alt="{{ f.heroAlt }}" fetchpriority="high" decoding="async" eleventy:ignore>
            </picture>
        </section>


        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

          DATES BANNER

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

{%- set bannerTitleText = f.datesTitle %}
{%- set bannerDetailsText = f.datesDetails %}
{% include "partials/dates-banner.njk" %}
        </div>

    <main>

        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

          DESCRIPTION OF DEBRIEF

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

        <article class="single-item">
            <h2 class="single-item__h2">{{ f.introHeading }}</h2>

            {{ f.introText | md("single-item__introduction") | safe }}

            {%- if f.introImage %}
            <img src="{{ f.introImage | siteImg }}" alt="{{ f.introImageAlt }}" class="single-item__image" sizes="(min-width: 1171px) 40vw, 90vw">
            {%- endif %}
        </article>


        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

            WALKTHROUGH VIDEO - switched on/off in the dashboard (Pages > Front page)

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

        {%- if f.showWalkthrough and (f.walkthroughVideoUrl or f.walkthroughVideoFile) %}
        <section class="coloured-block-section">
            <h2>
                {{ f.walkthroughHeading }}
            </h2>
            {%- if f.walkthroughVideoUrl %}
            {%- set videoSrc = f.walkthroughVideoUrl %}
            {%- set videoName = f.walkthroughHeading %}
            {% include "partials/video.njk" %}
            {%- else %}
            <video controls{% if f.walkthroughPoster %} poster="{{ f.walkthroughPoster | siteImg | url }}"{% endif %} playsinline id="walkthrough-video">
                    <source src="{{ f.walkthroughVideoFile | siteImg | url }}" type="video/mp4">
                    Your browser does not support the video tag.
            </video>
            {%- endif %}
            {%- if f.walkthroughCaption %}
            <p> {{ f.walkthroughCaption }}</p>
            {%- endif %}
        </section>
        {%- endif %}


        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

          QUOTE SECTION

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

        {%- if f.quote %}
        <section>

            <article class="quote-half">
                <h2 class="quote-half__h2">{{ f.quote }}
                </h2>
                {%- if f.quoteImage %}
                <img src="{{ f.quoteImage | siteImg }}" alt="{{ f.quoteImageAlt }}" class="quote-half__image" eleventy:widths="400,800,1200" sizes="(min-width: 1171px) 40vw, 90vw">
                {%- endif %}
            </article>

        </section>
        {%- endif %}


    </main>
