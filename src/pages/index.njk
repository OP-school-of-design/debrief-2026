---
layout: layouts/base.njk
title: Home
permalink: /
---
{%- set f = frontpage %}
        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

          LOOPING ANIMATION
          Desktop and mobile versions; lazy-loading means each visitor only downloads the one shown.

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

        <section class="logo-animation logo-animation--desktop">
            <img src="{{ f.heroDesktop | siteImg | url }}" alt="{{ f.heroAlt }}" loading="lazy" eleventy:ignore>
        </section>

        <section class="logo-animation logo-animation--mobile">
            <img src="{{ f.heroMobile | siteImg | url }}" alt="{{ f.heroAlt }}" loading="lazy" eleventy:ignore>
        </section>


        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

          DATES BANNER

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

{%- set bannerTitleText = f.datesTitle %}
{%- set bannerDetailsText = f.datesDetails %}
{% include "partials/dates-banner.njk" %}

    <main>

        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

          DESCRIPTION OF DEBRIEF

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

        <article class="single-item">
            <h2 class="single-item__h2">{{ f.introHeading }}</h2>

            {{ f.introText | md("single-item__introduction") | safe }}

            {%- if f.introImage %}
            <img src="{{ f.introImage | siteImg }}" alt="{{ f.introImageAlt }}" class="single-item__image" sizes="(min-width: 1171px) 40vw, 90vw">
            {%- endif %}
        </article>


        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

            WALKTHROUGH VIDEO - switched on/off in the dashboard (Pages > Front page)

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

        {%- if f.showWalkthrough and (f.walkthroughVideoUrl or f.walkthroughVideoFile) %}
        <section class="coloured-block-section">
            <h2>
                {{ f.walkthroughHeading }}
            </h2>
            {%- if f.walkthroughVideoUrl %}
            {%- set videoSrc = f.walkthroughVideoUrl %}
            {%- set videoName = f.walkthroughHeading %}
            {% include "partials/video.njk" %}
            {%- else %}
            <video controls{% if f.walkthroughPoster %} poster="{{ f.walkthroughPoster | siteImg | url }}"{% endif %} playsinline id="walkthrough-video">
                    <source src="{{ f.walkthroughVideoFile | siteImg | url }}" type="video/mp4">
                    Your browser does not support the video tag.
            </video>
            {%- endif %}
            {%- if f.walkthroughCaption %}
            <p> {{ f.walkthroughCaption }}</p>
            {%- endif %}
        </section>
        {%- endif %}


        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

          QUOTE SECTION

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

        {%- if f.quote %}
        <section>

            <article class="quote-half">
                <h2 class="quote-half__h2">{{ f.quote }}
                </h2>
                {%- if f.quoteImage %}
                <img src="{{ f.quoteImage | siteImg }}" alt="{{ f.quoteImageAlt }}" class="quote-half__image" eleventy:widths="400,800,1200" sizes="(min-width: 1171px) 40vw, 90vw">
                {%- endif %}
            </article>

        </section>
        {%- endif %}


    </main>
