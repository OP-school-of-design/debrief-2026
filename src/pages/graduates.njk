---
layout: layouts/base.njk
permalink: /graduates/
eleventyComputed:
  title: "{{ graduatespage.title }}"
---
        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

            PAGE BANNER (Pages > All Graduates page > Banner image).
            With no banner image chosen, a plain heading instead.

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

<main>

    {%- if graduatespage.bannerImage %}
    <section class="image-block-title">
        <img src="{{ graduatespage.bannerImage | siteImg }}" alt="{{ graduatespage.bannerAlt }}" sizes="100vw" loading="eager">
            <h1>
                {{ graduatespage.title }}
            </h1>
    </section>
    {%- else %}
    <section class="page-heading-plain">
        <h1>{{ graduatespage.title }}</h1>
    </section>
    {%- endif %}

        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

            STUDENT SELECTOR GRID

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

{#- Everyone in one list, in alphabetical order of last name (collections.graduates is already in that order). #}
{%- set grads = collections.graduates %}
{% include "partials/student-grid.njk" %}

</main>
