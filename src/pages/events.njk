---
layout: layouts/base.njk
title: Events
permalink: /events/
---
    <main>

        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

            PAGE BANNER

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

        <section class="image-block-title">
                <img src="{{ eventspage.bannerImage }}" alt="{{ eventspage.bannerAlt }}" sizes="100vw" loading="eager">
                    <h1>
                        {{ eventspage.title }}
                    </h1>
        </section>

        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

            EVENTS GRID

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

        <section class="event-grid">
            {%- for e in collections.events %}
            <a href="{{ e.url | url }}" class="no-link-look">
                <article class="event-card">
                    <img src="{{ e | entryImg(e.data.poster) }}" alt="{{ e.data.posterAlt }}" class="event-grid-poster" sizes="(min-width: 701px) 45vw, 95vw">
                    <h2>
                        {{ e.data.title }}
                    </h2>
                    <h3>
                        {{ e.data.subtitle }}
                    </h3>
                    {%- if e.data.gridDates %}
                    <p> {{ e.data.gridDates | nl2br | safe }} </p>
                    {%- endif %}
                </article>
            </a>
            {%- endfor %}
        </section>

    </main>
