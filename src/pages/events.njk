---
layout: layouts/base.njk
title: Events
permalink: /events/
---
<main id="main">
    <section class="image-block-title">
        <img src="{{ eventspage.bannerImage }}" alt="{{ eventspage.bannerAlt }}" sizes="100vw" loading="eager" fetchpriority="high">
        <h1>{{ eventspage.title }}</h1>
    </section>

    <section class="event-grid">
        {%- for e in collections.events %}
        <a href="{{ e.url | url }}" class="no-link-look">
            <article class="event-card">
                <img src="{{ e | entryImg(e.data.poster) }}" alt="{{ e.data.posterAlt or (e.data.title ~ ' poster') }}" class="event-grid-poster" sizes="(min-width: 601px) 540px, 95vw">
                <h2>{{ e.data.title }}</h2>
                <h3>{{ e.data.subtitle }}</h3>
                {%- if e.data.gridDates %}<p>{{ e.data.gridDates | nl2br | safe }}</p>{%- endif %}
            </article>
        </a>
        {%- endfor %}
    </section>
</main>
