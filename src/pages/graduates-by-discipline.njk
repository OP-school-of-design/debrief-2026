---
layout: layouts/base.njk
pagination:
  data: collections.disciplinePages
  size: 1
  alias: discipline
permalink: "/graduates/{{ discipline.data.disciplineKey }}/"
eleventyComputed:
  title: "{{ discipline.data.title }}"
  metaDescription: "{{ discipline.data.metaDescription }}"
---
{%- set d = discipline.data %}
    <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

        PAGE BANNER

    = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

    <section class="image-block-title">
            <img src="{{ discipline | entryImg(d.gradBannerImage or d.bannerImage) }}" alt="{{ d.gradBannerAlt }}" sizes="100vw" loading="eager">
                <h1>
                    {{ d.title }}
                </h1>
    </section>

<main>

        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

            STUDENT SELECTION GRID

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

{%- set grads = collections.graduates | where("data.discipline", d.disciplineKey) %}
{% include "partials/student-grid.njk" %}

</main>
