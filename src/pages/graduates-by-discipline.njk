{% set grads = collections.graduates | where("data.discipline", discipline.data.disciplineKey) %}
<main id="main">
    <h1 class="visually-hidden">{{ discipline.data.title }} Graduates</h1>
    {% include "partials/student-grid.njk" %}
</main>
