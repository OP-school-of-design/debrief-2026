---
layout: layouts/base.njk
pagination:
  data: collections.disciplines
  size: 1
  alias: discipline
permalink: "/graduates/{{ discipline.data.disciplineKey }}/"
eleventyComputed:
  title: "{{ discipline.data.title }} Graduates"
  metaDescription: "{{ discipline.data.metaDescription }}"
