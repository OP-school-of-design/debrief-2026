---
layout: layouts/base.njk
pagination:
  data: collections.disciplines
  size: 1
  alias: discipline
permalink: "/about/{{ discipline.data.disciplineKey }}/"
eleventyComputed:
  title: "About {{ discipline.data.title }}"
  metaDescription: "{{ discipline.data.metaDescription }}"
---
{%- set d = discipline.data %}
<main id="main">
    <section class="image-block-title">
        <img src="{{ discipline | entryImg(d.bannerImage) }}" alt="{{ d.bannerAlt }}" sizes="100vw" loading="eager" fetchpriority="high">
        <h1>About {{ d.title }}</h1>
    </section>

    <article class="discipline-description">
        <div class="discipline-description__text">
            <h2 class="discipline-description__h2">{{ d.introHeading }}</h2>
            {{ d.intro | md("discipline-description__introduction") | safe }}
        </div>
        {%- if d.image %}
        <div class="discipline-description__image-wrapper">
            <img src="{{ discipline | entryImg(d.image) }}" alt="{{ d.imageAlt }}" class="discipline-description__image" sizes="(min-width: 1171px) 40vw, 100vw">
        </div>
        {%- endif %}
    </article>

    <!-- CAROUSEL: can be switched on/off per discipline in the dashboard -->
    {% include "partials/carousel.njk" %}

    {%- if d.moreText %}
    <section>
        {{ d.moreText | md | safe }}
    </section>
    {%- endif %}

    {%- set embedSrc = d.videoUrl | embed %}
    {%- if embedSrc %}
    <section class="discipline-OP-video">
        <h2>{{ d.videoTitle }}</h2>
        <div class="youtube-video">
            <iframe id="walkthrough-video" src="{{ embedSrc }}" title="{{ d.videoTitle or d.title }} (video)" loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
    </section>
    {%- endif %}
</main>
