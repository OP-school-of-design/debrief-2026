---
layout: layouts/base.njk
hasCarousel: true
pagination:
  data: collections.disciplinePages
  size: 1
  alias: discipline
permalink: "/about/{{ discipline.data.disciplineKey }}/"
eleventyComputed:
  title: "About {{ discipline.data.title }}"
  metaDescription: "{{ discipline.data.metaDescription }}"
---
{%- set d = discipline.data %}
<main>

        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

            PAGE BANNER

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

<section class="image-block-title">
        <img src="{{ discipline | entryImg(d.bannerImage) }}" alt="{{ d.bannerAlt }}" sizes="100vw" loading="eager">
            <h1>
                About {{ d.title }}
            </h1>
</section>

        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

            DISCIPLINE DESCRIPTION

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

<article class="discipline-description">
    <div class="discipline-description__text">
        <h2 class="discipline-description__h2">
            {{ d.introHeading }}
        </h2>
        {{ d.intro | md("discipline-description__introduction") | safe }}
    </div>
    {%- if d.image %}
    <div class="discipline-description__image-wrapper">
        <img
            src="{{ discipline | entryImg(d.image) }}"
            alt="{{ d.imageAlt }}"
            class="discipline-description__image"
            sizes="(min-width: 1171px) 40vw, 90vw"
        >
    </div>
    {%- endif %}
</article>

        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

            COLOURED BLOCK VIDEO

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

        {%- if d.videoUrl | embed %}
        <section class="coloured-block-section">
            <article class="discipline-OP-video">
                <h2>
                        {{ d.videoTitle }}
                </h2>
{%- set videoSrc = d.videoUrl %}
{%- set videoName = d.videoTitle %}
{% include "partials/video.njk" %}
            </article>
        </section>
        {%- endif %}

        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

            CAROUSEL (switched on/off per discipline in the dashboard)

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

{%- set carouselEntry = discipline %}
{%- set carouselShow = d.showCarousel %}
{%- set carouselSlides = d.carousel %}
{%- set carouselAutoplay = d.carouselAutoplay %}
{%- set carouselInterval = d.carouselInterval %}
{%- set carouselText = d.moreText %}
{%- set carouselLabel = d.title %}
{% include "partials/carousel.njk" %}

</main>
