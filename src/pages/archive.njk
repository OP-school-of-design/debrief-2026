---
layout: layouts/base.njk
title: Archive
permalink: /archive/
---
<main id="main">
    <section class="image-block-title">
        <img src="{{ archive.bannerImage }}" alt="{{ archive.bannerAlt }}" sizes="100vw" loading="eager" fetchpriority="high">
        <h1>{{ archive.title }}</h1>
    </section>

    <section class="archive-section">
        {%- if archive.intro %}<p class="archive-intro">{{ archive.intro }}</p>{%- endif %}
        <ul class="archive-list">
            {%- for link in archive.links %}
            <li><a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label }}</a></li>
            {%- endfor %}
        </ul>
    </section>
</main>
