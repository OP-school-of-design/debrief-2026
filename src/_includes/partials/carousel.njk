{#- CAROUSEL SECTION (the students' markup; Flickity replaced by js/carousel.js).
    Set before including: carouselEntry (entry whose folder holds the images), carouselShow,
    carouselSlides, carouselAutoplay, carouselInterval, carouselText, carouselLabel. -#}
{%- set showSlides = carouselShow !== false and carouselSlides and carouselSlides.length %}
{%- if showSlides or carouselText %}
        <section class="carousel-section">
            {%- if showSlides %}
            <article class="main-carousel" aria-label="{{ carouselLabel }} image carousel"{% if carouselAutoplay %} data-autoplay="true" data-interval="{{ carouselInterval or 5 }}"{% endif %}>
                {%- for slide in carouselSlides %}
                <div class="carousel-cell"{% if slide.caption %} data-caption="{{ slide.caption }}"{% endif %}><img src="{{ carouselEntry | entryImg(slide.image) }}"
                        alt="{{ slide.alt }}" sizes="(min-width: 1171px) 80vw, 100vw"{% if loop.first %} loading="eager"{% endif %}>
                </div>
                {%- endfor %}
            </article>
            <p class="caption">&nbsp;</p>
            {%- endif %}
            {%- if carouselText %}
            {{ carouselText | md | safe }}
            {%- endif %}
        </section>
{%- endif %}
