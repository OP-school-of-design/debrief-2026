        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

          FOOTER (written once, used on every page)

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

        <footer>
            <div class="footer-grid">

                <article class="footer__image">
                    <img src="{{ site.footerLogo | siteImg }}" alt="{{ site.footerLogoAlt }}" class="footer__image__logo" eleventy:widths="400,800,1200" sizes="{{ site.footerLogo | siteImg | naturalSizes }}">
                </article>

                <article class="footer__menu">
                    <button class="footer__dropdown" type="button">
                        <h2>Events</h2>
                        <span class="footer__arrow"></span>
                    </button>
                    <ul class="footer__menu__list">
                        {%- for e in collections.events %}
                        <li><a href="{{ e.url | url }}">{{ e.data.footerLabel or e.data.navLabel or e.data.title }}</a></li>
                        {%- endfor %}
                    </ul>

                    <div class="footer__copyright-details">
                        <p>{{ site.footerNote | nl2br | safe }}</p>
                        <p xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/"><span
                        property="dct:title">This website</span> by <span property="cc:attributionName">{{ site.websiteCredit }}</span></p>
                    </div>

                </article>

                <article class="footer__menu">
                    <button class="footer__dropdown" type="button">
                        <h2>Graduates</h2>
                        <span class="footer__arrow"></span>
                    </button>
                    <ul class="footer__menu__list">
                        {%- for d in collections.gradCategories %}
                        <li><a href="{{ ('/graduates/' ~ d.data.disciplineKey ~ '/') | url }}">{{ d.data.title }}</a></li>
                        {%- endfor %}
                    </ul>
                </article>

                <article class="footer__menu">
                    <button class="footer__dropdown" type="button">
                        <h2>Social links</h2>
                        <span class="footer__arrow"></span>
                    </button>
                    <ul class="footer__menu__list">
                        {%- for s in site.socials %}
                        <li><a href="{{ s.url | safeUrl }}" target="_blank" rel="noopener noreferrer"><i class="{{ s.icon | faClass }}"></i> {{ s.label }}</a></li>
                        {%- endfor %}
                    </ul>
                </article>

            </div>

        </footer>
