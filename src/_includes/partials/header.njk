        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

          HEADER AND NAVIGATION (written once, used on every page)
          The dropdown lists are built from the dashboard: Disciplines, Events and Archive links.

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

        <header>
            <nav class="topnav" id="myTopnav">

                <!-- Logo -->
                <div>
                    <img src="{{ site.navLogo | siteImg }}" alt="{{ site.navLogoAlt }}" class="navlogo" loading="eager" eleventy:widths="400,800" sizes="225px">
                </div>

                <a href="{{ '/' | url }}">Home</a>

                <!-- All Graduates (categories with no graduates can be set to hide themselves) -->
                <div class="dropdown">
                    <div class="dropdown-title">
                        <a href="{{ '/graduates/' | url }}" class="dropbtn">{{ graduatespage.title }}</a>
                        <button type="button" class="dropdown-toggle" onclick="toggleDropdown(this)" aria-label="Toggle {{ graduatespage.title }} submenu">
                            <span class="material-symbols-outlined">expand_more</span>
                        </button>
                    </div>

                    <div class="dropdown-content">
                        {%- for d in collections.gradCategories %}
                        <a href="{{ ('/graduates/' ~ d.data.disciplineKey ~ '/') | url }}">{{ d.data.title }}</a>
                        {%- endfor %}
                    </div>
                </div>

                <!-- School of Design -->
                <div class="dropdown">
                    <div class="dropdown-title">
                        <a href="{{ '/school-of-design/' | url }}" class="dropbtn">School of Design</a>
                        <button type="button" class="dropdown-toggle" onclick="toggleDropdown(this)" aria-label="Toggle School of Design submenu">
                            <span class="material-symbols-outlined">expand_more</span>
                        </button>
                    </div>

                    <div class="dropdown-content">
                        {%- for d in collections.schoolDisciplines %}
                        <a href="{{ ('/about/' ~ d.data.disciplineKey ~ '/') | url }}">About {{ d.data.title }}</a>
                        {%- endfor %}
                    </div>
                </div>

                <!-- Events -->
                <div class="dropdown">
                    <div class="dropdown-title">
                        <a href="{{ '/events/' | url }}" class="dropbtn">Events</a>
                        <button type="button" class="dropdown-toggle" onclick="toggleDropdown(this)" aria-label="Toggle Events submenu">
                            <span class="material-symbols-outlined">expand_more</span>
                        </button>
                    </div>

                    <div class="dropdown-content">
                        {%- for e in collections.events %}
                        <a href="{{ e.url | url }}">{{ e.data.navLabel or e.data.title }}</a>
                        {%- endfor %}
                    </div>
                </div>

                <!-- Archive -->
                <div class="dropdown">
                    <div class="dropdown-title">
                        {%- if archive.pageUrl %}
                        <a href="{{ archive.pageUrl | url }}" class="dropbtn">Archive</a>
                        {%- else %}
                        <!-- No Archive page: the heading only opens the list of previous years -->
                        <a class="dropbtn" role="button" tabindex="0" aria-haspopup="true" onclick="toggleDropdown(this)">Archive</a>
                        {%- endif %}
                        <button type="button" class="dropdown-toggle" onclick="toggleDropdown(this)" aria-label="Toggle Archive submenu">
                            <span class="material-symbols-outlined">expand_more</span>
                        </button>
                    </div>

                    <div class="dropdown-content">
                        {%- for link in archive.links %}
                        <a href="{{ link.url }}" target="_blank">{{ link.label }}</a>
                        {%- endfor %}
                    </div>
                </div>

            </nav>


            <!-- Hamburger -->
            <button type="button" class="icon" id="menuToggle" onclick="toggleMenu()" aria-label="Toggle menu" aria-expanded="false" aria-controls="myTopnav">
                <span class="material-symbols-outlined" id="menuIcon">menu</span>
            </button>
        </header>
