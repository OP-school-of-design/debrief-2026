{#- Grid of graduate cards. Set `grads` (a list of graduate entries) before including this file. -#}
<section class="student-grid">
    {%- for g in grads %}
    <a href="{{ g.url | url }}" class="no-link-look">
        <article class="student-card">
            <img class="student-card__image"
                src="{{ g | entryImg(g.data.cover) }}"
                alt="{{ g.data.coverAlt or g.data.projectName or g.data.title }}"
                sizes="(min-width: 926px) 350px, (min-width: 601px) 46vw, 95vw">

            <div class="student-card__info">
                <img class="student-card__profile" src="{{ g | entryImg(g.data.headshot) }}" alt="" eleventy:widths="400,800" sizes="56px">
                <h3>{{ g.data.title }}</h3>
            </div>
        </article>
    </a>
    {%- endfor %}
</section>
