---
layout: layouts/base.njk
hasLightbox: true
---
{#- One graduate page, matching the students' two page designs. "Block order" in the dashboard:
      "profile" = portfolio-studentname.html (student info first; "-sn" classes)
      "project" = portfolio-projectname.html (project first, student info at the end)  -#}
{%- set disc = collections.disciplines | where("data.disciplineKey", discipline) | first %}
{%- set labels = { website: "Website", instagram: "Instagram", linkedin: "LinkedIn", facebook: "Facebook", youtube: "YouTube", behance: "Behance" } %}
{%- set sn = "-sn" if blockOrder == "profile" else "" %}

{%- set studentInfo %}
            <article class="student-contact-info{{ sn }}">
                <img class="student-profile{{ sn }}" src="{{ page | gradImg(headshot, 'headshot') }}" alt="{{ headshotAlt }}" eleventy:widths="400,800" sizes="300px">
                {%- if links and links.length %}
                <ul class="student-contacts{{ sn }}">
                    {%- for l in links %}
                    {%- if l.type == "email" %}
                    <li><i class="{{ 'email' | faClass }}"></i> {{ l.label or l.url }}</li>
                    {%- else %}
                    <li><a href="{{ l.url | safeUrl }}" target="_blank" rel="noopener noreferrer"><i class="{{ l.type | faClass }}"></i> {{ l.label or labels[l.type] or l.url }}</a></li>
                    {%- endif %}
                    {%- endfor %}
                </ul>
                {%- endif %}
            </article>

            <article class="student-written-info{{ sn }}">
                <h2> {{ title }} </h2>
                <h3> {{ disc.data.title }} </h3>
                {{ content | pclass("student-description" ~ sn) | safe }}
            </article>

            {%- if quote %}
            <p class="student-quote{{ sn }}"> {{ quote }} </p>
            {%- endif %}
{%- endset %}

{%- set projectInfo %}
        <article class="project-info{{ sn }}">
            <div class="project-info__title{{ sn }}">
                <h2> {{ projectName }} </h2>
                <h3> {{ title }} </h3>
            </div>
            {{ projectDescription | md | safe }}
        </article>
{%- endset %}

{%- set heroImage %}
{%- if hero %}
        <article class="portfolio-hero-image{{ sn }}">
            <img src="{{ page | entryImg(hero) }}" alt="{{ heroAlt }}" sizes="(min-width: 1171px) 80vw, 100vw">
            {#- The image description doubles as its caption. Screen readers already read it as the
                image's alt text, so the visible caption is hidden from them (aria-hidden). #}
            {%- if heroAlt %}
            <p class="image-caption" aria-hidden="true">{{ heroAlt }}</p>
            {%- endif %}
        </article>
{%- endif %}
{%- endset %}

{#- Optional YouTube/Vimeo video with a caption. It sits under the hero image, or above it when
    "Show the video above the hero image" is ticked in the dashboard. -#}
{%- set videoBlock %}
{%- if videoUrl | embed %}
        <article class="portfolio-video{{ sn }}{% if videoFirst %} video-first{% endif %}">
{%- set videoSrc = videoUrl %}
{%- set videoName = videoCaption or (title ~ ": video") %}
{% include "partials/video.njk" %}
            {%- if videoCaption %}
            <p class="image-caption">{{ videoCaption }}</p>
            {%- endif %}
        </article>
{%- endif %}
{%- endset %}

{%- set heroAndVideo %}
{%- if videoFirst %}{{ videoBlock | safe }}{{ heroImage | safe }}{% else %}{{ heroImage | safe }}{{ videoBlock | safe }}{% endif %}
{%- endset %}

{%- set gallerySection %}
{%- if gallery and gallery.length %}
        <article class="grid--masonry{{ sn }}">
            {%- for g in gallery %}
            {%- if g.alt %}
            <figure class="gallery-figure">
                <img src="{{ page | entryImg(g.image) }}" alt="{{ g.alt }}" sizes="(min-width: 1171px) 40vw, (min-width: 601px) 45vw, 100vw">
                <figcaption class="image-caption" aria-hidden="true">{{ g.alt }}</figcaption>
            </figure>
            {%- else %}
            <img src="{{ page | entryImg(g.image) }}" alt="{{ g.alt }}" sizes="(min-width: 1171px) 40vw, (min-width: 601px) 45vw, 100vw">
            {%- endif %}
            {%- endfor %}
        </article>
{%- endif %}
{%- endset %}

<main>
{%- if blockOrder == "profile" %}

        <!-- STUDENT INFO DESCRIPTION & CONTACTS -->
        <section class="student-info-sn">
{{ studentInfo | safe }}
        </section>

        <!-- HERO IMAGE (and video) -->
{{ heroAndVideo | safe }}

        <!-- PROJECT INFO DESCRIPTION -->
{{ projectInfo | safe }}

        <!-- MASONRY LAYOUT FOR PORTFOLIO WORK -->
{{ gallerySection | safe }}

{%- else %}

        <!-- PROJECT INFO, HERO IMAGE, MASONRY LAYOUT -->
<section class="project-content">
{{ projectInfo | safe }}
{{ heroAndVideo | safe }}
{{ gallerySection | safe }}
</section>

        <!-- STUDENT INFO DESCRIPTION & CONTACTS -->
        <section class="student-info">
{{ studentInfo | safe }}
        </section>

{%- endif %}

        <!-- LIGHTBOX CONTENT -->
    <div class="lightbox" id="lightbox">
        <button class="lightbox-close" aria-label="Close">
            &times;
        </button>
        <button class="lightbox-arrow lightbox-prev" aria-label="Previous image">
            &#10094;
        </button>
        <figure class="lightbox-figure">
            <img class="lightbox-image" id="lightbox-image" src="" alt="" eleventy:ignore>
            <figcaption class="lightbox-caption" id="lightbox-caption" aria-hidden="true" hidden></figcaption>
        </figure>
        <button class="lightbox-arrow lightbox-next" aria-label="Next image">
            &#10095;
        </button>
    </div>
</main>
