---
layout: layouts/base.njk
hasLightbox: true
---
{#- One graduate page, matching the students' two page designs. "Block order" in the dashboard:
      "profile" = portfolio-studentname.html (student info first; "-sn" classes)
      "project" = portfolio-projectname.html (project first, student info at the end)  -#}
{%- set disc = collections.disciplines | where("data.disciplineKey", discipline) | first %}
{%- set labels = { website: "Website", instagram: "Instagram", linkedin: "LinkedIn", facebook: "Facebook", youtube: "YouTube", behance: "Behance" } %}
{%- set sn = "-sn" if blockOrder == "profile" else "" %}

{%- set studentInfo %}
            <article class="student-contact-info{{ sn }}">
                <img class="student-profile{{ sn }}" src="{{ page | entryImg(headshot) }}" alt="{{ headshotAlt }}" eleventy:widths="400,800" sizes="300px">
                {%- if links and links.length %}
                <ul class="student-contacts{{ sn }}">
                    {%- for l in links %}
                    {%- if l.type == "email" %}
                    <li><i class="{{ 'email' | faClass }}"></i> {{ l.label or l.url }}</li>
                    {%- else %}
                    <li><a href="{{ l.url }}" target="_blank"><i class="{{ l.type | faClass }}"></i> {{ l.label or labels[l.type] or l.url }}</a></li>
                    {%- endif %}
                    {%- endfor %}
                </ul>
                {%- endif %}
            </article>

            <article class="student-written-info{{ sn }}">
                <h2> {{ title }} </h2>
                <h3> {{ disc.data.title }} </h3>
                {{ content | pclass("student-description" ~ sn) | safe }}
            </article>

            {%- if quote %}
            <p class="student-quote{{ sn }}"> {{ quote }} </p>
            {%- endif %}
{%- endset %}

{%- set projectInfo %}
        <article class="project-info{{ sn }}">
            <div class="project-info__title{{ sn }}">
                <h2> {{ projectName }} </h2>
                <h3> {{ title }} </h3>
            </div>
            {{ projectDescription | md | safe }}
        </article>
{%- endset %}

{%- set heroImage %}
        <article class="portfolio-hero-image{{ sn }}">
            <img src="{{ page | entryImg(hero) }}" alt="{{ heroAlt }}" sizes="(min-width: 1171px) 80vw, 100vw">
        </article>
{%- endset %}

{%- set gallerySection %}
        <article class="grid--masonry{{ sn }}">
            {%- for g in gallery %}
            <img src="{{ page | entryImg(g.image) }}" alt="{{ g.alt }}" sizes="(min-width: 1171px) 40vw, (min-width: 601px) 45vw, 100vw">
            {%- endfor %}
        </article>
{%- endset %}

<main>
{%- if blockOrder == "profile" %}

        <!-- STUDENT INFO DESCRIPTION & CONTACTS -->
        <section class="student-info-sn">
{{ studentInfo | safe }}
        </section>

        <!-- HERO IMAGE -->
{{ heroImage | safe }}

        <!-- PROJECT INFO DESCRIPTION -->
{{ projectInfo | safe }}

        <!-- MASONRY LAYOUT FOR PORTFOLIO WORK -->
{{ gallerySection | safe }}

{%- else %}

        <!-- PROJECT INFO, HERO IMAGE, MASONRY LAYOUT -->
<section class="project-content">
{{ projectInfo | safe }}
{{ heroImage | safe }}
{{ gallerySection | safe }}
</section>

        <!-- STUDENT INFO DESCRIPTION & CONTACTS -->
        <section class="student-info">
{{ studentInfo | safe }}
        </section>

{%- endif %}

        <!-- LIGHTBOX CONTENT -->
    <div class="lightbox" id="lightbox">
        <button class="lightbox-close" aria-label="Close">
            &times;
        </button>
        <button class="lightbox-arrow lightbox-prev" aria-label="Previous image">
            &#10094;
        </button>
        <img class="lightbox-image" id="lightbox-image" src="" alt="" eleventy:ignore>
        <button class="lightbox-arrow lightbox-next" aria-label="Next image">
            &#10095;
        </button>
    </div>
</main>
