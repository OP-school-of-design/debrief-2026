---
layout: layouts/base.njk
---
<main>

        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

        PAGE BANNER

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

    <section class="image-block-title">
        <img src="{{ bannerImage | siteImg }}" alt="{{ bannerAlt }}" sizes="100vw" loading="eager">
            <h1>
                {{ heading or title }}
            </h1>
    </section>

        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

        DISCIPLINE SELECT - DROPDOWN MENU (built from the dashboard's Disciplines)

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

    <section class="discipline-explore">
        <button class="standalone-h2 discipline-toggle" type="button">
           <h2> {{ disciplinesHeading }} </h2>
            <span class="discipline-arrow"></span>
        </button>

        <article class="discipline__grid">
            {%- for d in collections.schoolDisciplines %}
            <a href="{{ ('/about/' ~ d.data.disciplineKey ~ '/') | url }}" class="discipline"{% if d.data.boxColour %} style="background-color: {{ d.data.boxColour }}"{% endif %}>
                {%- set symbolSrc = d | entryImg(d.data.symbol) %}
                <img src="{{ symbolSrc }}" alt="{{ d.data.title }}" class="discipline__image" eleventy:widths="400,800" sizes="{{ symbolSrc | naturalSizes }}">
                <h2 class="discipline__name">{{ d.data.shortName or d.data.title }}</h2>
            </a>
            {%- endfor %}
        </article>
    </section>

        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

        DISCIPLINE DESCRIPTION

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

<article class="discipline-description">
    <div class="discipline-description__text">
        <h2 class="discipline-description__h2">
            {{ descHeading }}
        </h2>
        {{ content | pclass("discipline-description__introduction") | safe }}
    </div>
    {%- if descImage %}
    <div class="discipline-description__image-wrapper">
        <img
            src="{{ descImage | siteImg }}"
            alt="{{ descImageAlt }}"
            class="discipline-description__image"
            sizes="(min-width: 1171px) 40vw, 90vw"
        >
    </div>
    {%- endif %}
</article>

</main>
