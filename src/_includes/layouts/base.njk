<!DOCTYPE html>
<html lang="{{ site.lang or 'en-nz' }}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

{% include "partials/head-seo.njk" %}
{%- if site.favicon %}
    <link rel="icon" type="image/png" sizes="32x32" href="{{ '/favicon/icon-32.png' | url }}?v={{ build.version }}">
    <link rel="icon" type="image/png" sizes="192x192" href="{{ '/favicon/icon-192.png' | url }}?v={{ build.version }}">
    <link rel="apple-touch-icon" href="{{ '/favicon/apple-touch-icon.png' | url }}?v={{ build.version }}">
{%- endif %}

    {%- for href in fontface.preloads %}
    <link rel="preload" href="{{ href }}" as="font" type="font/woff2" crossorigin>
    {%- endfor %}

    <!-- base stylesheet -->
    <link rel="stylesheet" href="{{ '/css/base.css' | url }}?v={{ build.version }}">
    <!-- Maxis' original stylesheet -->
    <link rel="stylesheet" href="{{ '/css/stylesheet.css' | url }}?v={{ build.version }}">
    <!-- Colours and fonts from the dashboard (Design); defaults equal the students' values -->
    <link rel="stylesheet" href="{{ '/css/design.css' | url }}?v={{ build.version }}">
    <link rel="stylesheet" href="{{ '/css/icons.css' | url }}?v={{ build.version }}">
    <link rel="stylesheet" href="{{ '/fontawesome/css/all.min.css' | url }}?v={{ build.version }}">
    <link rel="stylesheet" href="{{ '/css/carousel.css' | url }}?v={{ build.version }}">
    <link rel="stylesheet" href="{{ '/css/additions.css' | url }}?v={{ build.version }}">
    {%- if (customcss and customcss.css and (customcss.css | trim)) or (responsivecss | responsiveCss) %}
    <!-- Custom and Responsive CSS from the dashboard (Design), loaded last. ADD YOUR CUSTOM CSS IN HERE. -->
    <link rel="stylesheet" href="{{ '/css/custom.css' | url }}?v={{ build.version }}">
    {%- endif %}

    {# Extra head code from the dashboard: Design > SEO & head code #}
{{ headcode | safe }}
</head>

<body>

{% include "partials/header.njk" %}

{{ content | safe }}

{% include "partials/footer.njk" %}

    <script src="{{ '/js/main.js' | url }}?v={{ build.version }}"></script>
    {%- if hasLightbox %}
    <script src="{{ '/js/lightbox.js' | url }}?v={{ build.version }}"></script>
    {%- endif %}
    {%- if hasCarousel %}
    <script src="{{ '/js/carousel.js' | url }}?v={{ build.version }}"></script>
    {%- endif %}
</body>
</html>
