<!DOCTYPE html>
<html lang="{{ site.lang or 'en-nz' }}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

{% include "partials/head-seo.njk" %}

    {%- for href in fontface.preloads %}
    <link rel="preload" href="{{ href }}" as="font" type="font/woff2" crossorigin>
    {%- endfor %}

    <link rel="stylesheet" href="{{ '/css/base.css' | url }}">
    <!-- The students' stylesheet -->
    <link rel="stylesheet" href="{{ '/css/stylesheet.css' | url }}">
    <!-- Colours and fonts from the dashboard (Design); defaults equal the students' values -->
    <link rel="stylesheet" href="{{ '/css/design.css' | url }}">
    <link rel="stylesheet" href="{{ '/css/icons.css' | url }}">
    <link rel="stylesheet" href="{{ '/fontawesome/css/all.min.css' | url }}">
    <link rel="stylesheet" href="{{ '/css/carousel.css' | url }}">
    {%- if customcss and customcss.css and (customcss.css | trim) %}
    <!-- Custom CSS from the dashboard (Design > Custom CSS), loaded last -->
    <link rel="stylesheet" href="{{ '/css/custom.css' | url }}">
    {%- endif %}

    {# Extra head code from the dashboard: Design > SEO & head code #}
    {{ seo.headCode | safe }}
</head>

<body>

{% include "partials/header.njk" %}

{{ content | safe }}

{% include "partials/footer.njk" %}

    <script src="{{ '/js/main.js' | url }}"></script>
    {%- if hasLightbox %}
    <script src="{{ '/js/lightbox.js' | url }}"></script>
    {%- endif %}
    {%- if hasCarousel %}
    <script src="{{ '/js/carousel.js' | url }}"></script>
    {%- endif %}
</body>
</html>
