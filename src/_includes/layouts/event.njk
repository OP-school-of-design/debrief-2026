---
layout: layouts/base.njk
hasCarousel: true
---
<main>

        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

          DESCRIPTION & POSTER

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

    <section class="event-description">
        <div class="event-poster-text">
            <h2> {{ heading or title }} </h2>
            {%- if detailDatesLine %}
            <h3> {{ detailDatesLine | nl2br | safe }} </h3>
            {%- endif %}
            {{ content | safe }}
        </div>
        {%- if poster %}
        <div class="event-poster-image">
            {%- set posterSrc = page | entryImg(poster) %}
            <img src="{{ posterSrc }}" alt="{{ posterAlt }}" class="event-poster" sizes="{{ posterSrc | naturalSizes }}">
        </div>
        {%- endif %}
    </section>

        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

            DATES BANNER

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

{%- if bannerTitle %}
{%- set bannerTitleText = bannerTitle %}
{%- set bannerDetailsText = bannerDetails %}
{% include "partials/dates-banner.njk" %}
{%- endif %}

        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

            CAROUSEL (switched on/off per event in the dashboard)

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

{%- set carouselEntry = page %}
{%- set carouselShow = showCarousel %}
{%- set carouselSlides = carousel %}
{%- set carouselAutoplay = carouselAutoplay %}
{%- set carouselInterval = carouselInterval %}
{%- set carouselText = moreText %}
{%- set carouselLabel = title %}
{% include "partials/carousel.njk" %}

        <!-- = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

            EVENT VIDEO

        = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = -->

        {%- if videoUrl | embed %}
        <section class="event-video">
            <h2>
                {{ videoTitle }}
            </h2>
{%- set videoSrc = videoUrl %}
{%- set videoName = videoTitle %}
{% include "partials/video.njk" %}
        </section>
        {%- endif %}
    </main>
