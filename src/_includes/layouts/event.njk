---
layout: layouts/base.njk
---
<main id="main">
    <!-- DESCRIPTION & POSTER -->
    <section class="event-description">
        <div class="event-poster-text">
            <h2>{{ heading or title }}</h2>
            {%- if detailDatesLine %}<h3>{{ detailDatesLine | nl2br | safe }}</h3>{%- endif %}
            {{ content | safe }}
        </div>
        {%- if poster %}
        <div class="event-poster-image">
            <img src="{{ page | entryImg(poster) }}" alt="{{ posterAlt or (title ~ ' poster') }}" class="event-poster" sizes="(min-width: 601px) 50vw, 90vw">
        </div>
        {%- endif %}
    </section>

    <!-- DATES BANNER (same look as the front page banner) -->
    {%- if bannerTitle %}
    <section class="debrief-dates">
        <h2 class="debrief-dates-title">{{ bannerTitle | nl2br("desktop-break") | safe }}</h2>
        {%- if bannerDetails %}<p>{{ bannerDetails | nl2br | safe }}</p>{%- endif %}
    </section>
    {%- endif %}

    <!-- CAROUSEL: can be switched on/off per event in the dashboard -->
    {% set carouselImgBase = page %}
    {% set carouselShow = showCarousel %}
    {% set carouselSlides = carousel %}
    {% set carouselAutoplay = carouselAutoplay %}
    {% set carouselInterval = carouselInterval %}
    {% set carouselLabel = title %}
    {% include "partials/carousel.njk" %}

    <!-- EVENT VIDEO -->
    {%- set embedSrc = videoUrl | embed %}
    {%- if embedSrc %}
    <section class="event-video">
        <h2>{{ videoTitle or title }}</h2>
        <div class="youtube-video">
            <iframe id="walkthrough-video" src="{{ embedSrc }}" title="{{ videoTitle or title }} (video)" loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
    </section>
    {%- endif %}
</main>
